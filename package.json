{
  "name": "@dsh-external/dsh-rp-shell",
  "version": "0.1.0",
  "description": "空容器角色扮演 Agent 预设插件（RP Shell）：无内置人格，人格与行为准则完全来自对话中导入的角色卡（/char），不附加设定之外的额外限制；支持 /char /roll /reset /status 命令与 Shell、文件、网页检索等工具交互，严格遵守用户指令。",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "preset",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=0.0.1-rc <2"
  },
  "scripts": {
    "build": "bash scripts/build.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ASAKAFENG/dsh-rp-shell.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "roleplay",
    "rp",
    "character-card"
  ],
  "dsh": {
    "plugin": true,
    "kind": "server",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  }
}
